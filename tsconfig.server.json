{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist-server"
  },
  "include": ["server/**/*.ts", "prisma/**/*.ts"]
}
