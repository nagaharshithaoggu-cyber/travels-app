DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
APP_MODE="demo"
# Optional provider keys. Live search/booking stays unavailable until an adapter is implemented and configured.
FLIGHT_PROVIDER_API_KEY=""
TRAIN_PROVIDER_API_KEY=""
BUS_PROVIDER_API_KEY=""
PAYMENT_PROVIDER_SECRET=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="TRAVERSE ELITE <no-reply@traverse.example>"
# Optional OpenStreetMap Nominatim-compatible geocoder settings.
GEOCODING_API_URL="https://nominatim.openstreetmap.org"
GEOCODING_USER_AGENT="TraverseElite/1.0 (contact: you@example.com)"
# Optional primary Overpass API endpoint for nearby essentials. The server tries public
# Overpass mirrors automatically if this endpoint is unavailable.
NEARBY_API_URL="https://overpass-api.de/api/interpreter"
# Optional Google Places API (New) key for richer place photos, ratings, and opening information.
# Enable Places API (New) and billing in the Google Cloud project before setting this server-only key.
GOOGLE_PLACES_API_KEY=""
# Optional first-admin bootstrap. When set, the seed command creates this account as an administrator.
ADMIN_EMAIL="admin@traverse.test"
ADMIN_PASSWORD="TraverseAdmin!2026"
